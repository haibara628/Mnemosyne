[Unit]
Description=Mnemosyne (CPKB) hourly news collection
After=network-online.target mnemosyne.service

[Service]
Type=oneshot
User=ecs-user
Group=ecs-user
WorkingDirectory=/home/ecs-user/workspace/Mnemosyne/backend
ExecStart=/home/ecs-user/workspace/Mnemosyne/backend/.venv/bin/python -m app.news_collector
